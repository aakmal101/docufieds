// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // Connection pooler URL (for runtime - port 6543)
  directUrl = env("DIRECT_URL")        // Direct connection URL (for migrations - port 5432)
}

model User {
  id                String      @id @default(cuid())
  email             String?     @unique
  phone             String?     @unique
  userId            String?     @unique @map("user_id")
  role              String      @default("INDIVIDUAL")
  status            String      @default("PENDING")
  memberId          String?     @unique @map("member_id")
  isVerified        Boolean     @default(false) @map("is_verified")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  // Profile information
  fullName          String?     @map("full_name")
  dateOfBirth       DateTime?   @map("date_of_birth")
  placeOfBirth      String?     @map("place_of_birth")
  photoUrl          String?     @map("photo_url")
  birthCertificateNumber String? @map("birth_certificate_number")
  nidNumber         String?     @map("nid_number")
  passportNumber    String?     @map("passport_number")
  
  // Address information (stored as text in SQLite)
  presentAddress    String?     @map("present_address")
  permanentAddress  String?     @map("permanent_address")
  
  // Agency specific
  agencyName        String?     @map("agency_name")
  agencyLicense     String?     @map("agency_license")
  creditLimit       Float?      @default(0) @map("credit_limit")
  outstandingAmount Float?      @default(0) @map("outstanding_amount")
  documentLimit     Int?        @default(10) @map("document_limit")
  documentsUsed     Int?        @default(0) @map("documents_used")
  lastPaymentDate   DateTime?   @map("last_payment_date")
  nextPaymentDue    DateTime?   @map("next_payment_due")
  
  // Authentication
  passwordHash      String?     @map("password_hash")

  // Additional Profile Fields (for Bulk Upload)
  nationality       String?
  passportExpiry    DateTime?   @map("passport_expiry")
  gender            String?
  maritalStatus     String?     @map("marital_status")
  
  // Profile Review
  profileStatus     String    @default("PENDING_REVIEW") @map("profile_status") // PENDING_REVIEW, APPROVED, DECLINED
  profileReviewedAt DateTime? @map("profile_reviewed_at")
  profileReviewedById String? @map("profile_reviewed_by_id")
  profileReviewNotes String?  @map("profile_review_notes")

  // Relations
  applications      Application[]
  payments          Payment[]
  documents         Document[]
  notifications     Notification[]
  sessions          Session[]
  messages          Message[]
  bulkUploads       BulkUpload[]
  auditLogs         AuditLog[]    @relation("AuditActor")
  targetAuditLogs   AuditLog[]    @relation("AuditTarget")

  // Support Team Relations
  teamMembers         SupportTeamMember[]     @relation("TeamLeadMembers")
  assignedByMe        ApplicationAssignment[] @relation("AssignedByLead")
  escalationsResolved Escalation[]            @relation("EscalationResolver")
  rejectionReviews    RejectionRequest[]      @relation("RejectionReviewer")
  autoAssignConfigs   AutoAssignmentConfig[]  @relation("AutoAssignConfig")
  supportMessages     SupportMessage[]        @relation("UserMessages")
  
  @@map("users")
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String   @map("actor_user_id")
  action        String
  targetUserId  String?  @map("target_user_id")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  actor         User     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  targetUser    User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model Session {
  id        String   @id @default(cuid())
  sessionToken String @unique @map("session_token")
  userId    String @map("user_id")
  expires   DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

model Application {
  id                String            @id @default(cuid())
  userId            String            @map("user_id")
  country           String
  processType       String            @map("process_type")
  profession        String?
  consultancyFee    Float             @map("consultancy_fee")
  status            String            @default("DRAFT")
  memberId          String?           @map("member_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  
  // Relations
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents         Document[]
  payments          Payment[]
  statusUpdates     ApplicationStatusUpdate[]
  messages          Message[]
  bulkUploadId       String?
  bulkUpload         BulkUpload? @relation(fields: [bulkUploadId], references: [id])
  bulkUploadRecordId String?
  bulkUploadRecord   BulkUploadRecord?

  // Support Portal Fields
  supportStatus       String            @default("PENDING_ASSIGNMENT") @map("support_status")
  assignedAt          DateTime?         @map("assigned_at")
  lastActivityAt      DateTime?         @map("last_activity_at")
  forwardedToLegalAt  DateTime?         @map("forwarded_to_legal_at")
  
  // Support Relations
  assignment          ApplicationAssignment?
  documentRequests    DocumentRequest[]
  supportMessages     SupportMessage[]
  escalations         Escalation[]
  rejectionRequests   RejectionRequest[]
  
  @@index([bulkUploadId])
  @@map("applications")
}

model Document {
  id            String   @id @default(cuid())
  applicationId String   @map("application_id")
  userId        String   @map("user_id")
  fileName      String   @map("file_name")
  fileUrl       String   @map("file_url")
  fileType      String   @map("file_type")
  fileSize      Int      @map("file_size")
  documentType  String   @map("document_type")
  isRequired    Boolean  @default(false) @map("is_required")
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  uploadedAt    DateTime @default(now()) @map("uploaded_at")
  
  // Relations
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentRequests DocumentRequest[]
  
  @@map("documents")
}

model Payment {
  id            String        @id @default(cuid())
  applicationId String?       @map("application_id")
  userId        String        @map("user_id")
  amount        Float
  status        String        @default("PENDING")
  method        String
  transactionId String?       @map("transaction_id")
  gatewayResponse String?     @map("gateway_response")
  invoiceNumber   String?     @unique @map("invoice_number")
  dueDate         DateTime?   @map("due_date")
  description     String?
  paidAt          DateTime?   @map("paid_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  
  // Relations
  application   Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
  @@map("payments")
}



model Notification {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  title     String
  message   String
  type      String
  priority  String   @default("NORMAL")
  actionUrl String?  @map("action_url")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  
  // Relations
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId  String?  @map("member_id")
  member    SupportTeamMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  @@index([userId, isRead, createdAt])
  @@index([memberId, isRead, createdAt])
  @@map("notifications")
}

model OTP {
  id        String   @id @default(cuid())
  phone     String?
  email     String?
  code      String
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("otps")
}

model Country {
  id          String @id @default(cuid())
  name        String
  code        String @unique
  continent   String
  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@map("countries")
}

model DocumentRequirement {
  id          String @id @default(cuid())
  country     String
  processType String @map("process_type")
  profession  String?
  documentType String @map("document_type")
  isRequired  Boolean @default(true) @map("is_required")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@map("document_requirements")
}

model DocumentTemplate {
  id          String @id @default(cuid())
  documentType String @map("document_type")
  country     String?
  processType String? @map("process_type")
  fileName    String @map("file_name")
  fileUrl     String @map("file_url")
  fileType    String @map("file_type")
  fileSize    Int @map("file_size")
  uploadedBy  String @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("document_templates")
}

model Message {
  id            String   @id @default(cuid())
  applicationId String?  @map("application_id")
  userId        String   @map("user_id")
  senderId      String   @map("sender_id")
  senderRole    String   @map("sender_role")
  text          String
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at")
  
  // Relations
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("messages")
  @@index([applicationId])
  @@index([userId])
  @@index([createdAt])
}

model BulkUpload {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // File Information
  fileName          String
  fileUrl           String
  fileSize          Int
  uploadedAt        DateTime @default(now())
  
  // Processing Stats
  totalRecords      Int
  processedRecords  Int      @default(0)
  successfulRecords Int      @default(0)
  failedRecords     Int      @default(0)
  skippedRecords    Int      @default(0)
  
  // Status Tracking
  status            String   @default("PENDING") // PENDING, VALIDATING, PROCESSING, COMPLETED, FAILED, CANCELLED
  currentPhase      String?  // Upload, Validation, Processing, Completed
  errorSummary      Json?    // Summary of errors
  
  // Timestamps
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime @updatedAt
  
  // Relations
  records           BulkUploadRecord[]
  applications      Application[]
  
  @@index([userId])
  @@index([status])
  @@map("bulk_uploads")
}

model BulkUploadRecord {
  id              String   @id @default(cuid())
  bulkUploadId    String
  bulkUpload      BulkUpload @relation(fields: [bulkUploadId], references: [id], onDelete: Cascade)
  
  // Record Information
  rowNumber       Int
  originalData    Json     // Store complete row data for audit
  
  // Processing Status
  status          String   // PENDING, VALIDATING, PROCESSING, SUCCESS, FAILED, SKIPPED
  errorMessage    String?  @db.Text
  warningMessage  String?  @db.Text
  
  // Created Application
  applicationId   String?  @unique
  application     Application? @relation(fields: [applicationId], references: [id])
  
  // User Association
  createdUserId   String?  // If new user was created
  existingUserId  String?  // If matched to existing user
  
  // Timestamps
  createdAt       DateTime @default(now())
  processedAt     DateTime?
  
  @@index([bulkUploadId])
  @@index([status])
  @@map("bulk_upload_records")
}

// ============================================
// SUPPORT TEAM PORTAL MODELS
// ============================================

model SupportTeamMember {
  id              String    @id @default(cuid())
  
  // Account credentials
  email           String    @unique
  passwordHash    String    @map("password_hash")
  
  // Profile
  fullName        String    @map("full_name")
  phone           String?
  photoUrl        String?   @map("photo_url")
  
  // Status
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")
  
  // Relationship to Lead
  leadId          String    @map("lead_id")
  lead            User      @relation("TeamLeadMembers", fields: [leadId], references: [id])
  
  // Assignments
  assignedApplications ApplicationAssignment[]
  
  // Activity
  documentRequests    DocumentRequest[]
  messages            SupportMessage[]
  statusUpdates       ApplicationStatusUpdate[]
  escalations         Escalation[]            @relation("EscalatedBy")
  rejectionRequests   RejectionRequest[]
  notifications       Notification[]
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  @@map("support_team_members")
}

model ApplicationAssignment {
  id              String    @id @default(cuid())
  
  // What is assigned
  applicationId   String    @unique @map("application_id")
  application     Application @relation(fields: [applicationId], references: [id])
  
  // Who it's assigned to
  memberId        String    @map("member_id")
  member          SupportTeamMember @relation(fields: [memberId], references: [id])
  
  // Who assigned it
  assignedById    String    @map("assigned_by_id")
  assignedBy      User      @relation("AssignedByLead", fields: [assignedById], references: [id])
  
  // Assignment details
  assignmentType  String    @default("MANUAL") @map("assignment_type") // AUTO, MANUAL, REASSIGNED
  priority        String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  notes           String?
  
  // Status tracking
  status          String    @default("ACTIVE") // ACTIVE, COMPLETED, REASSIGNED, ESCALATED
  
  // Timestamps
  assignedAt      DateTime  @default(now()) @map("assigned_at")
  completedAt     DateTime? @map("completed_at")
  
  @@map("application_assignments")
}

model DocumentRequest {
  id              String    @id @default(cuid())
  
  // Application reference
  applicationId   String    @map("application_id")
  application     Application @relation(fields: [applicationId], references: [id])
  
  // Who requested
  requestedById   String    @map("requested_by_id")
  requestedBy     SupportTeamMember @relation(fields: [requestedById], references: [id])
  
  // Request details
  documentType    String    @map("document_type")
  reason          String
  instructions    String?
  
  // Status
  status          String    @default("PENDING") // PENDING, UPLOADED, ACCEPTED, REJECTED, EXPIRED, CANCELLED
  
  // User response
  responseDocumentId  String?   @map("response_document_id")
  responseDocument    Document? @relation(fields: [responseDocumentId], references: [id])
  userNotes           String?   @map("user_notes")
  respondedAt         DateTime? @map("responded_at")
  
  // Timestamps
  requestedAt     DateTime  @default(now()) @map("requested_at")
  expiresAt       DateTime? @map("expires_at")
  
  @@map("document_requests")
}

model SupportMessage {
  id              String    @id @default(cuid())
  
  // Conversation reference
  applicationId   String    @map("application_id")
  application     Application @relation(fields: [applicationId], references: [id])
  
  // Message content
  content         String
  messageType     String    @default("TEXT") @map("message_type") // TEXT, SYSTEM, DOCUMENT_REQUEST, STATUS_UPDATE
  
  // Sender info
  senderType      String    @map("sender_type") // USER, SUPPORT_MEMBER, SYSTEM
  
  // Polymorphic sender relations
  senderUserId    String?   @map("sender_user_id")
  senderUser      User?     @relation("UserMessages", fields: [senderUserId], references: [id])
  
  senderMemberId  String?   @map("sender_member_id")
  senderMember    SupportTeamMember? @relation(fields: [senderMemberId], references: [id])
  
  // Attachments
  attachmentUrl   String?   @map("attachment_url")
  attachmentName  String?   @map("attachment_name")
  
  // Read status
  isReadByUser    Boolean   @default(false) @map("is_read_by_user")
  isReadBySupport Boolean   @default(false) @map("is_read_by_support")
  
  // Internal flag (not visible to user)
  isInternal      Boolean   @default(false) @map("is_internal")
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  
  @@map("support_messages")
}

model Escalation {
  id              String    @id @default(cuid())
  
  // Application reference
  applicationId   String    @map("application_id")
  application     Application @relation(fields: [applicationId], references: [id])
  
  // Who escalated
  escalatedById   String    @map("escalated_by_id")
  escalatedBy     SupportTeamMember @relation("EscalatedBy", fields: [escalatedById], references: [id])
  
  // Escalation details
  reason          String
  priority        String    @default("HIGH")
  
  // Status
  status          String    @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED, DISMISSED
  
  // Resolution
  resolvedById    String?   @map("resolved_by_id")
  resolvedBy      User?     @relation("EscalationResolver", fields: [resolvedById], references: [id])
  resolution      String?
  
  // Timestamps
  escalatedAt     DateTime  @default(now()) @map("escalated_at")
  resolvedAt      DateTime? @map("resolved_at")
  
  @@map("escalations")
}

model RejectionRequest {
  id              String    @id @default(cuid())
  
  // Application reference
  applicationId   String    @map("application_id")
  application     Application @relation(fields: [applicationId], references: [id])
  
  // Who requested
  requestedById   String    @map("requested_by_id")
  requestedBy     SupportTeamMember @relation(fields: [requestedById], references: [id])
  
  // Rejection details
  reason          String
  category        String    // INCOMPLETE_DOCUMENTS, INVALID_DOCUMENTS, FRAUDULENT_APPLICATION, INELIGIBLE_APPLICANT, PAYMENT_ISSUES, OTHER
  
  // Approval workflow
  status          String    @default("PENDING") // PENDING, APPROVED, DENIED
  
  // Lead decision
  reviewedById    String?   @map("reviewed_by_id")
  reviewedBy      User?     @relation("RejectionReviewer", fields: [reviewedById], references: [id])
  leadNotes       String?   @map("lead_notes")
  
  // Timestamps
  requestedAt     DateTime  @default(now()) @map("requested_at")
  reviewedAt      DateTime? @map("reviewed_at")
  
  @@map("rejection_requests")
}

model ApplicationStatusUpdate {
  id              String    @id @default(cuid())
  
  // Application reference
  applicationId   String    @map("application_id")
  application     Application @relation(fields: [applicationId], references: [id])
  
  // Status change
  fromStatus      String    @map("from_status")
  toStatus        String    @map("to_status")
  
  // Who made the change
  changedByType   String    @map("changed_by_type") // "USER", "SUPPORT_MEMBER", "SUPPORT_LEAD", "SYSTEM"
  changedById     String?   @map("changed_by_id")
  changedByMemberId String? @map("changed_by_member_id")
  member          SupportTeamMember? @relation(fields: [changedByMemberId], references: [id])
  
  // Details
  notes           String?
  isVisibleToUser Boolean   @default(true) @map("is_visible_to_user")
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  
  @@map("application_status_updates")
}

model AutoAssignmentConfig {
  id              String    @id @default(cuid())
  
  // Configuration
  isEnabled       Boolean   @default(true) @map("is_enabled")
  assignmentMode  String    @default("ROUND_ROBIN") @map("assignment_mode") // ROUND_ROBIN, LEAST_LOADED
  
  // Limits
  maxActivePerMember  Int   @default(10) @map("max_active_per_member")
  
  // Created by Lead
  createdById     String    @map("created_by_id")
  createdBy       User      @relation("AutoAssignConfig", fields: [createdById], references: [id])
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  @@map("auto_assignment_config")
}